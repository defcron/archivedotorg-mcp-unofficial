{
  "name": "archivedotorg-mcp-unofficial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial Internet Archive MCP server: Wayback Machine on Cloudflare Workers",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "dev": "npm run build && node scripts/dev.mjs",
    "deploy": "npm run check && node scripts/deploy.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm test && prettier --check .",
    "format": "prettier --write ."
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261104.0-beta",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
